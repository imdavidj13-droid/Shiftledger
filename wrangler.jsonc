{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiftledger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiftledger-db",
      "database_id": "2cf26224-48d7-42fe-aab9-a651f2b52342",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "keep_vars": true,
  "vars": {
    "APP_URL": "https://shiftledger.imdavidj13.workers.dev",
    "MAIL_FROM": "ShiftLedger <onboarding@resend.dev>"
  }
}
